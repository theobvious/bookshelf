# ── Backend (Railway) ─────────────────────────────────────────────────────────

# Absolute path to the SQLite file on the persistent volume
# e.g. /data/bookshelf.db
DATABASE_URL=sqlite:////data/bookshelf.db

# Absolute path to the uploads directory on the persistent volume
# e.g. /data/uploads
UPLOAD_DIR=/data/uploads

# Google OAuth client ID (from Google Cloud Console)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Comma-separated list of email addresses allowed to sign in
# Leave blank to allow any verified Google account
ALLOWED_EMAILS=you@example.com

# Secret used to sign JWTs — generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-secret

# Comma-separated list of frontend origins allowed by CORS
# In production this is your Vercel URL
ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:5173

# Anthropic API key
ANTHROPIC_API_KEY=sk-ant-...

# ── Frontend (Vercel) ─────────────────────────────────────────────────────────

# Full URL of your Railway backend (no trailing slash)
VITE_BACKEND_URL=https://your-backend.up.railway.app

# Google OAuth client ID (same value as above)
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
